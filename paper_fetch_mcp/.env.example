# Copy to paper_fetch_mcp/.env (gitignored).

# Checkout that owns the paper corpus: references.bib and
# pre_processing_v2/{papers.db,mistral_output,...}. Without it only the online
# tools return content.
CORPUS_ROOT=/home/you/ai_researcher

# Semantic Scholar (optional -- unauthenticated calls work at a lower rate limit)
SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-key-here

# Where a RELATIVE get_paper(save_path=...) is written (default <repo>/saved_papers)
# PAPER_SAVE_DIR=/home/you/paper-fetch-mcp/saved_papers

# Job queue + telemetry DBs (default <repo>/.state)
# STATE_DIR=/home/you/paper-fetch-mcp/.state

# Mistral OCR (Azure-hosted endpoint; needed by the corpus checkout's
# pre_processing_v2/mistral_ocr.py, which ingest_arxiv runs as a subprocess)
MISTRAL_API_KEY=your-mistral-api-key-here
