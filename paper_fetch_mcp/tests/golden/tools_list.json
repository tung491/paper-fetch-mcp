    "get_paper": {
      "output_schema": {
        "properties": {
          "result": {
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "x-fastmcp-wrap-result": true
      },
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "identifier": {
            "description": "A citation key, DOI (any form -- normalised), arXiv id\n(bare, \"arXiv:\"-prefixed, or a full arxiv.org URL), or paper\ntitle.",
            "type": "string"
          },
          "max_chars_per_paper": {
            "default": 12000,
            "description": "Maximum content characters to return in one\ncall (default 12000).",
            "type": "integer"
          },
          "offset": {
            "default": 0,
            "description": "Character offset into the assembled content to start the\nreturned window at (default 0) -- page through a long paper\nwith repeated calls, e.g. `offset=12000`, `offset=24000`, ...",
            "type": "integer"
          },
          "save_path": {
            "default": "",
            "description": "Optional file (or directory) to write the paper's FULL\ncontent to -- the whole assembled paper, not just the window\nthis call returns, so one call with `save_path` gets a long\npaper onto disk without paging it through the tool result.\nWorks for an online hit too (what was fetched is written).\nA relative path is resolved under `PAPER_SAVE_DIR`\n(default `<repo>/saved_papers`), an absolute path is used\nas given; a path that is an existing directory, ends with\n\"/\", or has no extension is treated as a directory and the\nfile inside it is named `<citation_key>.md`. Missing parents\nare created; an existing file is overwritten (`overwrote:\ntrue` in the report).",
            "type": "string"
          }
        },
        "required": [
          "identifier"
        ],
        "type": "object"
      }
    },
