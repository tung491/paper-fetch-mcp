{
  "_meta": {
    "description": "Golden contract snapshot for PaperFetchServer's live tool surface. 'tools' is regenerated live at test time from mcp.list_tools() and diffed against this file. 'response_key_paths' is documentation derived by reading tool bodies (not called live) -- see the 'source' citation on each entry.",
    "reblessing": "Set UPDATE_TOOL_CONTRACT=1 and rerun paper_fetch_mcp/tests/test_tool_contract.py to rewrite this file from the current live state. Any diff is a deliberate, reviewed change -- review it like code."
  },
  "response_key_paths": {
    "get_paper": {
      "paths": [
        "found",
        "content",
        "paging.truncated"
      ],
      "source": "core/papers.py `get_paper` returns {found, citation_key, id, doi, title, content, paging: {offset, returned_chars, total_chars, truncated}}; tools/content.py passes it to `output.respond(result)` (or core/online.py's envelope on a corpus miss, which carries the same found/content/paging keys)."
    },
    "semantic_scholar_search": {
      "paths": [
        "papers[].title"
      ],
      "source": "core/s2.py requests the title field from the Semantic Scholar API and returns {'ok': True, 'data': {'total': ..., 'papers': [...]}}; tools/external.py's semantic_scholar_search then does `output.respond({'total': ..., 'papers': data.get('papers', [])}, list_key='papers')`."
    }
  },
  "tools": {
    "alphaxiv_batch_lookup": {
      "output_schema": {
        "properties": {
          "result": {
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "x-fastmcp-wrap-result": true
      },
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "max_chars": {
            "default": 2000,
            "description": "Truncate each paper's overview/full_text to this many\ncharacters (default 2000 -- batch responses overflowed 100% of\nthe time before this limit existed).",
            "type": "integer"
          },
          "paper_ids_or_urls": {
            "description": "List of ArXiv IDs, versioned IDs, or URLs (max\n20).",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "paper_ids_or_urls"
        ],
        "type": "object"
      }
    },
    "alphaxiv_paper_lookup": {
      "output_schema": {
        "properties": {
          "result": {
            "type": "string"
          }
        },
        "required": [
          "result"
        ],
        "type": "object",
        "x-fastmcp-wrap-result": true
      },
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "max_chars": {
            "default": 15000,
            "description": "Truncate the fetched overview/full_text to this many\ncharacters (default 15000).",
            "type": "integer"
          },
          "paper_id_or_url": {
            "description": "An ArXiv ID, versioned ID, or URL.",
            "type": "string"
          }
        },
        "required": [
          "paper_id_or_url"
        ],
        "type": "object"
      }
    },
